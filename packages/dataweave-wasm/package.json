{
  "name": "@estebanwasinger/dataweave-wasm",
  "version": "1.3.1",
  "description": "Node.js WASM bindings for the DataWeave Rust runtime",
  "repository": "https://github.com/estebanwasinger/dataweave-py",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "dist"
  ],
  "scripts": {
    "build": "wasm-pack build ../../crates/dwpy-wasm --target nodejs --out-dir ../../packages/dataweave-wasm/dist --release",
    "test": "node --test test/*.test.js",
    "test:rust": "bash ../../scripts/test_wasm_rust.sh"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com/"
  }
}
